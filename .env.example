# WaspBot settings. Most people need NONE of this: the Setup page asks for your keys when you first open the site.
# Copy to .env (next to docker-compose.yml) only if you want to change something. NEVER commit .env.

# ---- Mode -------------------------------------------------------------------
# dry  = PAPER TRADING (the default): real market prices, simulated money, no exchange account needed
# demo = OKX demo trading with per-wasp DEMO keys, fake money on OKX's side
# live = REAL MONEY. Needs DRY_RUN=false, MODE=live, per-wasp LIVE keys AND LIVE_ACK below. Not financial advice.
MODE=dry
# Safety latch. true (the default, also when unset) forces paper trading whatever MODE says.
DRY_RUN=true
# Only for MODE=live: must be exactly I-ACCEPT-REAL-MONEY-RISK. You can lose everything you put in.
LIVE_ACK=

# ---- Setup ------------------------------------------------------------------
# The Setup page needs a one-time code printed in the engine's log at every start (docker compose logs engine).
# 20 wrong codes lock Setup until a restart. Set SETUP_CODE only if you cannot read the logs.
SETUP_CODE=
# The Setup page stays open this many minutes after the engine starts; once saved it closes for good. If nobody
# finishes in time, restart the engine container to open it again.
SETUP_WINDOW_MIN=120
# The owner password is picked on Setup and stored as a hash. Set this only if your Setup file has none (keys set only
# here). At least 8 characters. Gates the dashboard's Controls and resuming after the portfolio breaker.
OWNER_PASSWORD=

# ---- Decisions: the rules engine or a model ------------------------------------
# Who picks each wasp's next move among the moves its style allows. Switchable at runtime from the dashboard's
# Controls (owner password); anything set here is the default at start.
#   DECISION_ENGINE=rules   the deterministic code chooser: free, reproducible, what the backtester measures.
#   DECISION_ENGINE=llm     a model picks (LLM_PROVIDER), and the code chooser stands in over the cap, when the model is
#                           down or when it answers off the menu. Blank = llm (with no key that is the code chooser too).
# MODE=live runs on a model with a key, or on DECISION_ENGINE=rules chosen on purpose.
# Stops, caps, sizing and every portfolio rule are code, whatever decides.
DECISION_ENGINE=
# auto = the first with a key in the order gemini, claude, jev (openai only when named).
LLM_PROVIDER=auto

# Claude (Anthropic). Key from https://console.anthropic.com/. Set the prices to your model's current list price
# (USD per million tokens); the daily cap counts with them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=8000
ANTHROPIC_DAILY_USD_CAP=3
ANTHROPIC_USD_PER_MTOK=1
ANTHROPIC_USD_PER_MTOK_OUT=5
ANTHROPIC_MIN_INTERVAL_MS=60000

# OpenAI as the decision model (LLM_PROVIDER=openai; the key is OPENAI_API_KEY below).
OPENAI_DECISION_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=8000
OPENAI_DAILY_USD_CAP=3
OPENAI_USD_PER_MTOK=1
OPENAI_USD_PER_MTOK_OUT=5
OPENAI_MIN_INTERVAL_MS=60000

# Gemini 4 Argon. Key from Google AI Studio (https://aistudio.google.com/apikey), in a project with billing on:
# the free tier cannot use Argon. README: "Run it with Gemini 4 Argon".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_TIMEOUT_MS=3000
# Daily Gemini spend cap in USD as the engine counts it, for all three wasps together. Each call reserves its worst case
# before it is sent; a call that does not fit is not sent (the code chooser answers, and the dashboard says so).
GEMINI_DAILY_USD_CAP=3
# USD per million tokens, input and output (thinking counts as output). Both must be above 0. The defaults are Argon's
# price after the launch offer ($4 / $20). Until 30 Nov 2026 the launch price is $2 / $10 (announced by Google on
# 13 Oct 2026), so until then the counter prices tokens at twice the billed rate. Check Google's pricing page.
GEMINI_USD_PER_MTOK=4
GEMINI_USD_PER_MTOK_OUT=20
# At most one paid call per wasp per this many ms, whatever TICK_MS is. In between, the wasp keeps what it has.
GEMINI_MIN_INTERVAL_MS=60000
# Optional thinkingConfig.thinkingLevel (blank = the model's default).
GEMINI_THINKING_LEVEL=

# Jev (TypeSafe AI). Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Daily Jev spend threshold in USD (soft): no new Jev call once today's spend plus the calls in flight would pass it.
# Jev bills by its own token count, so calls already in flight can take a day somewhat over it. JEV_USD_PER_MTOK must be
# above 0.
JEV_DAILY_USD_CAP=2

# How often each wasp is looked at (ms): stops, caps and the code chooser run every tick. Jev is asked every tick
# (10000 = 18 decisions/min for three wasps, about $0.90/day, docs/COSTS.md); other models at most every *_MIN_INTERVAL_MS.
TICK_MS=10000
# Full market refresh (candles, indicators, funding, OI): every 60 s
DATA_REFRESH_MS=60000

# ---- OpenAI -------------------------------------------------------------------
# Setup asks for this (required there): it designs each wasp from a sentence, and paints it. It can also be the
# decision model (above) or the knowledge model (below).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- OKX (EEA) --------------------------------------------------------------
# Market data comes from OKX's public EEA API. Demo/live keys must be EEA (my.okx.com) keys.
OKX_API_BASE=https://eea.okx.com

# Demo or live only: one OKX sub-account per wasp (the variable names keep BEE1..BEE3). Keys: Read + Trade ONLY. Never Withdraw, never Transfer.
# Live keys should be IP-bound to your server. Demo keys come from OKX's demo-trading screen.
BEE1_OKX_DEMO_API_KEY=
BEE1_OKX_DEMO_API_SECRET=
BEE1_OKX_DEMO_API_PASSPHRASE=
BEE2_OKX_DEMO_API_KEY=
BEE2_OKX_DEMO_API_SECRET=
BEE2_OKX_DEMO_API_PASSPHRASE=
BEE3_OKX_DEMO_API_KEY=
BEE3_OKX_DEMO_API_SECRET=
BEE3_OKX_DEMO_API_PASSPHRASE=
BEE1_OKX_API_KEY=
BEE1_OKX_API_SECRET=
BEE1_OKX_API_PASSPHRASE=
BEE2_OKX_API_KEY=
BEE2_OKX_API_SECRET=
BEE2_OKX_API_PASSPHRASE=
BEE3_OKX_API_KEY=
BEE3_OKX_API_SECRET=
BEE3_OKX_API_PASSPHRASE=

# ---- Risk (every wasp) --------------------------------------------------------
BEE_START_EQUITY_USD=333
MAX_LEVERAGE=2
# Per-wasp daily loss stop, % of that wasp's equity at 00:00 UTC. Trip = flat until 00:00 UTC.
DAILY_LOSS_STOP_PCT=8
# If a wasp's equity falls below this % of its start, it retires for good.
BEE_RETIRE_AT_PCT=40
# Hard ceiling on any wasp's position size, whatever its balance says
MAX_NOTIONAL_USD_PER_BEE=700
# First hours of live trading run at reduced size
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=2
MIN_24H_VOL_USD=1000000
ALLOW_NON_CRYPTO=false

# ---- Portfolio rules (all three wasps together) -------------------------------------
# Breaker: total equity this % below its peak closes everything and holds until the owner resumes (dashboard).
PORTFOLIO_MAX_DRAWDOWN_PCT=20
# Breaker: total equity this % below today's 00:00 UTC level closes everything until the next UTC day.
PORTFOLIO_DAILY_LOSS_PCT=6
# Max |net notional| of all wasps together, as a multiple of total equity (three wasps long BTC is one big bet).
NET_EXPOSURE_MAX_X=1
# Max wasps in the same coin on the same side.
SAME_COIN_MAX_WASPS=2
# Market data older than this closes open positions (minutes; 0 = off).
STALE_FLATTEN_MINUTES=10
# Keep Trend and Momentum out of ranging markets and trends the other way; Breakout out of choppy ones.
REGIME_FILTER=true

# ---- News sources (docs/KNOWLEDGE.md) ---------------------------------------------
# Each one is also switchable from the dashboard's Controls.
NEWS_RSS=true
# Comma-separated feed URLs. Blank = CoinDesk, Cointelegraph, Decrypt, The Block.
NEWS_RSS_FEEDS=
# CryptoPanic (free token at https://cryptopanic.com/developers/api/). Off without a token.
NEWS_CRYPTOPANIC=true
CRYPTOPANIC_TOKEN=
CRYPTOPANIC_API_URL=
# The knowledge model searches the web itself (Claude, Gemini or OpenAI search tool). Costs more: hourly by default.
NEWS_WEB_SEARCH=false
NEWS_WEB_SEARCH_EVERY_MIN=60
# OKX's own bullish/bearish sentiment (demo and live only: it needs a signed key).
NEWS_OKX=true

# ---- Knowledge layer (docs/KNOWLEDGE.md) ------------------------------------------
# It can VETO or SHRINK an opening trade, never open one. Each part is switchable from the dashboard.
KNOWLEDGE_DIGEST=true
KNOWLEDGE_CALENDAR=true
KNOWLEDGE_MEMORY=true
KNOWLEDGE_NOTES=true
# The model that reads the news (auto = the first with a key: claude, gemini, openai; off = keyword digests only).
KNOWLEDGE_LLM_PROVIDER=auto
# Blank = the provider's decision model above. A cheap model is plenty.
KNOWLEDGE_LLM_MODEL=
# Hard daily budget for news digests and web search together, USD.
KNOWLEDGE_DAILY_USD_CAP=1
CLAUDE_USD_PER_SEARCH=0.01
DIGEST_EVERY_MIN=30
# Similar past trades needed before trade memory changes a size.
MEMORY_MIN_SAMPLES=15
# The event calendar file (created from docs/events.example.json on first start) and an optional iCalendar feed.
EVENTS_PATH=./data/events.json
EVENTS_ICS_URL=
# Your own notes (.md/.txt) the model reads with every decision.
NOTES_DIR=./data/notes
NOTES_MAX_CHARS=4000

# ---- Per-style knobs ------------------------------------------------------------
# BIZZY_* = Breakout (Jacket), BREEZY_* = Trend (Vespa), BOOZY_* = Momentum (Hornet). Every wasp on that style uses them.
# See strategies/*.md. COOLDOWN_MINUTES: wait after an order. STOP_ATR_MULT: stop distance in ATR(14).
# The values below are the defaults (Gemini 4 Argon's rules, strategies/ARGON_INTENDED.json). A value set in your .env
# beats the default even after an update: `pnpm effective-config .env --diff strategies/ARGON_INTENDED.json` lists them.
BREEZY_MAX_TRADES_PER_DAY=2
BREEZY_FEE_BUDGET_USD_DAY=0.75
BREEZY_MIN_OPEN_PROB=0.55
BREEZY_MIN_SIZE_USD=10
BREEZY_SPREAD_GATE_BPS=5
BREEZY_COOLDOWN_MINUTES=240
BREEZY_STOP_ATR_MULT=2

BIZZY_MAX_TRADES_PER_DAY=4
BIZZY_FEE_BUDGET_USD_DAY=1.20
BIZZY_SIZE_FRACTION=0.5
BIZZY_UNIVERSE_SIZE=8
BIZZY_SPREAD_GATE_BPS=5
BIZZY_COOLDOWN_MINUTES=30
BIZZY_STOP_ATR_MULT=2
BIZZY_TIME_STOP_MINUTES=240

BOOZY_MAX_TRADES_PER_DAY=3
BOOZY_FEE_BUDGET_USD_DAY=1.50
BOOZY_SPREAD_GATE_BPS=8
BOOZY_CANDIDATES=5
BOOZY_COOLDOWN_MINUTES=60
BOOZY_STOP_ATR_MULT=2.5

# ---- Server -------------------------------------------------------------------
# A domain pointed at this server gets automatic HTTPS. Blank = plain HTTP on the server's IP.
PUBLIC_DOMAIN=
LOG_LEVEL=info
# Alerts (optional): a Telegram bot, ntfy.sh topic or any webhook URL. Cap trips, decision-model outages, restarts.
ALERT_WEBHOOK_URL=
# A Hive (public paper-trading leaderboard). Blank = none. Nothing is sent unless you join from the dashboard.
HIVE_URL=
# ---- The Beekeeper (optional) -------------------------------------------------
# A Zap on Zapier that may rewrite one wasp's rules when they stop working. See docs/BEEKEEPER.md.
# Most people set NONE of these: connect it from the dashboard instead. Anything set here wins over the dashboard.
# Your WaspBot starts every round itself. It sends the Zap its own address and a 15-minute key, so the Zap holds
# no secret and no address.
# The Catch Hook URL from step 1 of your Zap. Must start with https://. Treat it like a password.
BEEKEEPER_WEBHOOK_URL=
# Where the Zap finds this server, like https://bees.example.com or http://your-server-ip (no path).
# Blank = https://<PUBLIC_DOMAIN> when that is set, else the address you connected from.
PUBLIC_URL=
# Hours between rounds. Blank = 4. Each round costs Zapier tasks (see docs/BEEKEEPER.md).
BEEKEEPER_EVERY_HOURS=
# Optional warm-up. Set a start time (like 2026-10-02T13:00:00Z) and rounds run hourly for 12 h,
# then every 2 h for 12 h, then every 3 h for 12 h, then every BEEKEEPER_EVERY_HOURS.
BEEKEEPER_RAMP_START=

# "Update available" on the dashboard when a newer GitHub Release is out. It never installs anything by itself.
UPDATE_CHECK=true
# Dashboard links: the code link (and an optional hosting link).
HOST_LINK=
REPO_LINK=https://github.com/AugisKo/waspbot
UPDATE_REPO=AugisKo/waspbot
